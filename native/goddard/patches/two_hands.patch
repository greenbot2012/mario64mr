 void stub_draw_objects_1(void) {
+}
+
+
+/**
+ * MarioFace: update_view's pick-and-drag for the second cursor. The cursor fields of gGdCtrl are swapped for
+ * gMarioFaceCtrl2's while the original picking (find_closest_pickable_obj) and dragging (drag_picked_object)
+ * run, so the second hand grabs and stretches exactly like the first.
+ */
+static void mario_face_second_hand(struct ObjView *view) {
+    s32 csrX = gGdCtrl.csrX, csrY = gGdCtrl.csrY;
+    s32 dragStartX = gGdCtrl.dragStartX, dragStartY = gGdCtrl.dragStartY;
+    u8 dragging = gGdCtrl.dragging, startedDragging = gGdCtrl.startedDragging;
+    s32 pickOffset, pickDataIdx, pickDataSize, pickedObjType, i, j;
+
+    gGdCtrl.csrX = gMarioFaceCtrl2.csrX;
+    gGdCtrl.csrY = gMarioFaceCtrl2.csrY;
+    gGdCtrl.dragStartX = gMarioFaceCtrl2.dragStartX;
+    gGdCtrl.dragStartY = gMarioFaceCtrl2.dragStartY;
+    gGdCtrl.dragging = gMarioFaceCtrl2.dragging;
+    gGdCtrl.startedDragging = gMarioFaceCtrl2.startedDragging;
+
+    if (gGdCtrl.dragging) {
+        if (gd_getproperty(3, 0) != FALSE && gGdCtrl.startedDragging != FALSE) {
+            init_pick_buf(sPickBuffer, ARRAY_COUNT(sPickBuffer));
+            drawscene(FIND_PICKS, view->components, NULL);
+            pickOffset = get_cur_pickbuf_offset(sPickBuffer);
+            sPickDataTemp = 0;
+            sPickedObject = NULL;
+            sPickObjDistance = 10000000.0f;
+            pickDataIdx = 0;
+            for (i = 0; i < pickOffset; i++) {
+                pickDataSize = sPickBuffer[pickDataIdx++];
+                if (pickDataSize != 0) {
+                    pickedObjType = sPickBuffer[pickDataIdx++];
+                    if (pickDataSize >= 2) {
+                        for (j = 0; j < pickDataSize - 1; j++) {
+                            sPickDataTemp = sPickBuffer[pickDataIdx++];
+                            apply_to_obj_types_in_group(pickedObjType, (applyproc_t) find_closest_pickable_obj,
+                                                        view->components);
+                        }
+                    }
+                }
+            }
+            // The first hand keeps what it holds
+            if (sPickedObject != NULL && sPickedObject != view->pickedObj) {
+                sPickedObject->drawFlags |= OBJ_PICKED | OBJ_HIGHLIGHTED;
+                gMarioFacePicked2 = sPickedObject;
+                gGdCtrl.dragStartX = gGdCtrl.csrX = sGrabCords.x;
+                gGdCtrl.dragStartY = gGdCtrl.csrY = sGrabCords.y;
+            }
+        }
+        if (gMarioFacePicked2 != NULL && gMarioFacePicked2 != view->pickedObj) {
+            gMarioFaceSecondPass = TRUE;
+            drag_picked_object(gMarioFacePicked2);
+            gMarioFaceSecondPass = FALSE;
+            gMarioFaceHolding2 = TRUE;
+        }
+    } else if (gMarioFacePicked2 != NULL) {
+        if (gMarioFacePicked2 != view->pickedObj) gMarioFacePicked2->drawFlags &= ~(OBJ_PICKED | OBJ_HIGHLIGHTED);
+        gMarioFacePicked2 = NULL;
+    }
+
+    gMarioFaceCtrl2.csrX = gGdCtrl.csrX;
+    gMarioFaceCtrl2.csrY = gGdCtrl.csrY;
+    gMarioFaceCtrl2.dragStartX = gGdCtrl.dragStartX;
+    gMarioFaceCtrl2.dragStartY = gGdCtrl.dragStartY;
+    gGdCtrl.csrX = csrX;
+    gGdCtrl.csrY = csrY;
+    gGdCtrl.dragStartX = dragStartX;
+    gGdCtrl.dragStartY = dragStartY;
+    gGdCtrl.dragging = dragging;
+    gGdCtrl.startedDragging = startedDragging;
 }
